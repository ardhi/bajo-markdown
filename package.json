{
  "name": "bajo-markdown",
  "version": "2.5.0",
  "description": "Markdown support for Bajo Framework",
  "main": "index.js",
  "scripts": {
    "build-doc": "jsdoc -c .jsdoc.conf.json",
    "test": "mocha"
  },
  "type": "module",
  "bajo": {
    "type": "plugin",
    "alias": "md"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ardhi/bajo-markdown.git"
  },
  "keywords": [
    "markdown",
    "bajo",
    "framework",
    "fastify",
    "modular"
  ],
  "author": "Ardhi Lukianto <ardhi@lukianto.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ardhi/bajo-markdown/issues"
  },
  "homepage": "https://github.com/ardhi/bajo-markdown#readme",
  "dependencies": {
    "gray-matter": "^4.0.3",
    "marked": "^15.0.12",
    "marked-alert": "^2.1.2",
    "marked-custom-heading-id": "^2.0.11",
    "marked-extended-tables": "^2.0.1",
    "marked-highlight": "^2.2.3",
    "marked-katex-extension": "^5.1.6",
    "marked-mangle": "^1.1.12",
    "marked-smartypants-lite": "^1.0.3",
    "node-emoji": "^2.2.0"
  },
  "devDependencies": {
    "chai": "^6.2.2",
    "clean-jsdoc-theme": "^4.3.0",
    "jsdoc-plugin-intersection": "^1.0.4",
    "mocha": "^11.7.6"
  }
}
